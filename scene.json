 + 0.14*(0.5+0.5*math.sin(math.min(time,236)/4.6899999999999995+9))"}}},{"id":"song-progress","start":0,"duration":239.95833333333334,"transform":{"position":[96,933],"opacity":1,"anchor":[0,0]},"content":{"kind":"shape","items":[{"type":"rect","size":[1008,3],"position":[504,0]},{"type":"fill","color":"#C99164"}]},"animations":{"scale":{"keyframes":[{"time":0,"value":[0.001,1],"easing":"linear"},{"time":239.5,"value":[1,1]}]}}},{"id":"lyrics","start":0,"duration":239.95833333333334,"content":{"kind":"captions","transcript":{"tags":{"verse":"Verse","chorus":"Chorus","bridge":"Bridge","unsatisfied":"UnSatisfied ending"},"segments":[{"start":19.538,"end":24.343,"text":"Too little too late\nmistakes have already been made","tags":["verse"]},{"start":24.343,"end":26.446,"text":"Blood and tears have already\nspilled on the floor","tags":["verse"]},{"start":26.446,"end":29,"text":"Life seems to have slammed\nthe door on hope","tags":["verse"]},{"start":29,"end":33.796,"text":"Can you remember blue skies\nwhen you cared","tags":["verse"]},{"start":33.796,"end":36.338,"text":"Before traveling this black mold\nof ungrateful holes","tags":["verse"]},{"start":36.338,"end":39.62,"text":"Where's the calling for me\nto find Golden sunshine","tags":["verse"]},{"start":39.62,"end":44.263,"text":"Satisfied with half the man\ndestiny claims for me","tags":["chorus"]},{"start":44.263,"end":49.246,"text":"Satisfied underneath\nthe desert rain today","tags":["chorus"]},{"start":49.246,"end":53.568,"text":"Satisfied withheld nothing\nis ever understandable","tags":["chorus"]},{"start":53.568,"end":58.5,"text":"Satisfied inside my living\nHell of negative creativity","tags":["chorus"]},{"start":68.805,"end":73.508,"text":"Umbrella of music seems\nto have some new holes","tags":["verse"]},{"start":73.508,"end":75.87,"text":"Healing rhythm plays onwards\npassing the soul","tags":["verse"]},{"start":75.87,"end":78.332,"text":"Days aglow still the words\nmust flow through my skull","tags":["verse"]},{"start":78.332,"end":82.334,"text":"Cornered alone reaching out\nfor guidance from you","tags":["verse"]},{"start":82.334,"end":85.557,"text":"Somehow music hears the call\nanswers from the notes","tags":["verse"]},{"start":85.557,"end":88.98,"text":"Bliss whenever the songs\nare playing in my head","tags":["verse"]},{"start":88.98,"end":93.602,"text":"Satisfied with half the man\ndestiny claims for me","tags":["chorus"]},{"start":93.602,"end":98.244,"text":"Satisfied underneath\nthe desert rain today","tags":["chorus"]},{"start":98.244,"end":102.946,"text":"Satisfied withheld nothing\nis ever understandable","tags":["chorus"]},{"start":102.946,"end":110,"text":"Satisfied inside my living\nHell of negative creativity","tags":["chorus"]},{"start":112.591,"end":115.55,"text":"Offspring now off springing\nnew generation of Roots","tags":["verse"]},{"start":115.55,"end":118.021,"text":"Straight through the heart\nnurturing unfelt bond","tags":["verse"]},{"start":118.021,"end":120.201,"text":"Look in my eyes\nfor protection from life","tags":["verse"]},{"start":120.201,"end":122.442,"text":"How do we stop the poison\nthat leaks from my soul","tags":["verse"]},{"start":122.442,"end":125.062,"text":"Project white trash trying\nto unlock the reasons why","tags":["verse"]},{"start":125.062,"end":128.963,"text":"Looking for a better spot\nin this universe to call home","tags":["verse"]},{"start":128.963,"end":134.264,"text":"Satisfied with half the man\ndestiny claims for me","tags":["chorus"]},{"start":134.264,"end":139.245,"text":"Satisfied underneath\nthe desert rain today","tags":["chorus"]},{"start":139.245,"end":143.026,"text":"Satisfied withheld nothing\nis ever understandable","tags":["chorus"]},{"start":143.026,"end":149.6,"text":"Satisfied inside my living\nHell of negative creativity","tags":["chorus"]},{"start":151,"end":155.084,"text":"Walk with me as the world\npushes death towards now","tags":["verse"]},{"start":155.084,"end":159.047,"text":"Stay close as we reminisce\nabout our past lifes","tags":["verse"]},{"start":159.047,"end":161.609,"text":"Yesterday's legacy stories\nheld inside the masks","tags":["verse"]},{"start":161.609,"end":165.812,"text":"Is there courage found\nin historical forgiveness","tags":["verse"]},{"start":165.812,"end":168.073,"text":"Was the outcome\nsomething without control","tags":["verse"]},{"start":168.073,"end":171.05,"text":"No fate no destination\nno right moves for us to make","tags":["verse"]},{"start":171.05,"end":176.45,"text":"Satisfied with half the man\ndestiny claims for me","tags":["chorus"]},{"start":176.45,"end":181.202,"text":"Satisfied underneath\nthe desert rain today","tags":["chorus"]},{"start":181.202,"end":185.466,"text":"Satisfied withheld nothing\nis ever understandable","tags":["chorus"]},{"start":185.466,"end":190.79,"text":"Satisfied inside my living\nHell of negative creativity","tags":["chorus"]},{"start":190.79,"end":196.034,"text":"Too late\nsay to goodbye","tags":["bridge"]},{"start":196.034,"end":198.356,"text":"Acceptance of the haters","tags":["bridge"]},{"start":198.356,"end":200.838,"text":"Can not defend your lies","tags":["bridge"]},{"start":200.838,"end":203.16,"text":"UnSatisfied cried","tags":["unsatisfied"]},{"start":203.16,"end":205.282,"text":"To blind to see the light","tags":["bridge"]},{"start":205.282,"end":207.15,"text":"Skies dripping blood again","tags":["bridge"]},{"start":207.15,"end":210.033,"text":"Can I summon my afterlife","tags":["bridge"]},{"start":210.033,"end":214.817,"text":"Satisfied with half the man\ndestiny claims for me","tags":["chorus"]},{"start":214.817,"end":219.621,"text":"Satisfied underneath\nthe desert rain today","tags":["chorus"]},{"start":219.621,"end":223.725,"text":"Satisfied withheld nothing\nis ever understandable","tags":["chorus"]},{"start":223.725,"end":231.9,"text":"Satisfied inside my living\nHell of negative creativity","tags":["chorus"]},{"start":232.032,"end":234.4,"text":"UnSatisfied life","tags":["unsatisfied"]}]},"style":{"font":{"family":"font-bold","size":62},"color":"#F2E8E3","alignment":"center","wrapWidth":1010,"offset":[-360,12],"letterSpacing":0.1},"styles":{"chorus":{"font":{"family":"font-bold","size":72},"color":"#E7B587"},"bridge":{"font":{"family":"font-bold","size":74},"color":"#EDCDC2"},"unsatisfied":{"font":{"family":"font-bold","size":100},"color":"#DF8E7F"},"verse":{}},"tagStyles":{"chorus":"chorus","bridge":"bridge","unsatisfied":"unsatisfied"}}}]}